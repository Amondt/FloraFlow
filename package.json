{
  "name": "flora-flow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src/**/*.ts src/**/*.html --no-warn-ignored",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"supabase/functions/**/*.ts\" \"supabase/**/*.sql\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"supabase/functions/**/*.ts\" \"supabase/**/*.sql\"",
    "tw": "tailwindcss -i ./src/styles.input.css -o ./src/styles.css",
    "tw:watch": "tailwindcss -i ./src/styles.input.css -o ./src/styles.css --watch",
    "dev": "concurrently \"ng serve\" \"tailwindcss -i ./src/styles.input.css -o ./src/styles.css --watch\"",
    "types": "bunx supabase gen types typescript --local > src/types/database.types.ts"
  },
  "private": true,
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@primeng/themes": "^21.0.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "idb": "^8.0.3",
    "postcss": "^8.5.14",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.7",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/cli": "^4.3.0",
    "eslint": "^10.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.0.8"
  }
}
